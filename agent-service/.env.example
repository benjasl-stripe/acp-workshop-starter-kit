# Agent Service Configuration

# Lambda endpoint (the shared AI brain)
LAMBDA_ENDPOINT=Replace_this_with_the_workshop_Stripe_Lambda_endpoint_URL

# Agents Stripe account (Proxy URL)
STRIPE_PROXY_URL=Replace_this_with_the_workshop_Stripe_proxy_URL

WORKSHOP_SECRET=Replace_this_with_the_workshop_secret

# Stripe Configuration (Agent's Stripe account)
STRIPE_PUBLISHABLE_KEY=pk_test_51SmzDZQ8qlzmjUmcxfSG2KpS67Xhyt5tXTXYxfUNK41R6fU7iGESKjuEKzcHUyXUP3Rpe60MQeO5k9B6Qo5Bhq8300SyQnQyMk

# Merchant Backend URL
MERCHANT_API_URL=http://localhost:4000

# Server Configuration
PORT=3001
SPT_SIMULATION_MODE=false

# --- Local Dev: OpenRouter Override ---
# Set both to bypass Lambda and use OpenRouter directly.
# Provisioned via: stripe projects add openrouter/api
# Key is auto-pulled to the root .env by Stripe Projects.
# USE_OPENROUTER=true
# OPENROUTER_API_KEY=sk-or-v1-...  (or loaded from root .env automatically)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
